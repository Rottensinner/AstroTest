---
import '@fontsource/vt323/400.css';
import '@fontsource/dseg14-classic/400.css';
import '../styles/global.css';
import '../styles/grunge.css';
import Button from '../components/Button.astro';
import Panel from '../components/Panel.astro';
import Clock from '../components/Clock.astro';
import Input from '../components/Input.astro';
import Textarea from '../components/Textarea.astro';
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0d0b0b" />
  <title>MEMENTO — Grunge UI</title>
</head>
<body>
  <main class="grunge">
    <svg class="grunge-defs" width="0" height="0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="memento-edge" x="-15%" y="-15%" width="130%" height="130%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency=".065" numOctaves="4" seed="13" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>
    <div class="grunge-shell">
      <nav class="grunge-nav" aria-label="Nawigacja">
        <a href="/">← RETRO UI</a>
        <span>STUDY SYSTEM / 001</span>
        <a href="/game">DEEP SPACE →</a>
      </nav>
      <header class="grunge-masthead">
        <p class="grunge-label">ARCHIVE OF THE LIVING / VOL. 01</p>
        <h1>MEMENTO</h1>
        <p class="grunge-strip grunge-frame">KNOWLEDGE RESISTS DECAY</p>
      </header>
      <section class="memento-poster" aria-label="Ilustracje Memento">
        <figure class="memento-artwork">
          <img src="/artwork/roses.png" alt="Róże w czerwono-czarnym sitodruku" width="642" height="194" />
        </figure>
        <p class="grunge-strip grunge-frame">A CERTAIN SUBTLE GRANDEUR</p>
        <figure class="memento-artwork">
          <img src="/artwork/eye.png" alt="Oko w ziarnistej czerwono-czarnej stylistyce" width="642" height="195" />
        </figure>
        <p class="grunge-strip grunge-frame">IN THE WITHERING THAT CONSUMES US ALL</p>
        <div class="memento-triptych">
          <figure class="memento-artwork">
            <img src="/artwork/raven.png" alt="Kruk" width="212" height="343" />
          </figure>
          <figure class="memento-artwork">
            <img src="/artwork/skeleton.png" alt="Rycina szkieletu" width="212" height="343" />
          </figure>
          <figure class="memento-artwork">
            <img src="/artwork/skulls.png" alt="Kompozycja czaszek" width="211" height="343" />
          </figure>
        </div>
      </section>
      <p class="grunge-strip grunge-frame grunge-section-label">I. / DISCIPLINE IS A FORM OF MEMORY</p>
      <div class="grunge-grid">
        <div class="grunge-cell grunge-wide">
          <Panel title="01 / Current session">
            <span class="grunge-label">SUBJECT / 001</span>
            <h3>Astro &amp; TypeScript</h3>
            <p>Komponenty, routing i architektura interfejsu.</p>
            <label for="memento-progress">PRZYKŁADOWY POSTĘP / 65%</label>
            <progress class="retro-progress" id="memento-progress" value="65" max="100">65%</progress>
            <a class="retro-button" href="https://docs.astro.build/en/basics/astro-components/">DOKUMENTACJA ASTRO →</a>
          </Panel>
        </div>
        <div class="grunge-cell grunge-narrow">
          <Panel title="02 / Focus timer">
            <div class="grunge-display">
              <span id="memento-timer" class="grunge-digits" role="timer">25:00</span>
              <span id="memento-timer-status" role="status" class="grunge-label">READY</span>
            </div>
            <div class="grunge-controls">
              <Button id="memento-start" variant="primary">START</Button>
              <Button id="memento-reset">RESET</Button>
            </div>
          </Panel>
        </div>
        <div class="grunge-cell grunge-five">
          <Panel title="03 / Notes">
            <Input id="memento-note-title" label="Temat" placeholder="SUBJECT..." />
            <Textarea id="memento-note" label="Notatka" placeholder="RECORD YOUR THOUGHTS..." rows={4} />
            <p class="grunge-label">SZKIC / BEZ ZAPISU</p>
          </Panel>
        </div>
        <div class="grunge-cell grunge-three">
          <Panel title="04 / Time">
            <Clock />
            <span class="grunge-label">LOCAL TIME</span>
            <span class="retro-badge">SYSTEM ONLINE</span>
          </Panel>
        </div>
        <div class="grunge-cell grunge-four">
          <Panel title="05 / Index">
            <table class="retro-table">
              <thead><tr><th>MODUŁ</th><th>STATUS</th></tr></thead>
              <tbody><tr><td>ASTRO</td><td>01</td></tr><tr><td>CSS</td><td>02</td></tr><tr><td>TS</td><td>03</td></tr></tbody>
            </table>
          </Panel>
        </div>
      </div>
      <footer class="grunge-footer">
        <span>MEMENTO / V.01</span><span>REMEMBER EVERYTHING</span>
      </footer>
    </div>
  </main>
</body>
</html>
<script>
  const display = document.querySelector<HTMLElement>('#memento-timer');
  const status = document.querySelector<HTMLElement>('#memento-timer-status');
  const start = document.querySelector<HTMLButtonElement>('#memento-start');
  const reset = document.querySelector<HTMLButtonElement>('#memento-reset');
  const duration = 25 * 60;
  let remaining = duration;
  let deadline = 0;
  let interval: number | undefined;

  function render() {
    if (display) display.textContent = String(Math.floor(remaining / 60)).padStart(2, '0') + ':' + String(remaining % 60).padStart(2, '0');
  }
  function stop() {
    if (interval !== undefined) window.clearInterval(interval);
    interval = undefined;
  }
  function tick() {
    remaining = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
    render();
    if (remaining === 0) {
      stop();
      if (start) start.textContent = 'START';
      if (status) status.textContent = 'COMPLETE';
    }
  }
  start?.addEventListener('click', () => {
    if (interval !== undefined) {
      tick();
      stop();
      start.textContent = 'START';
      if (status && remaining > 0) status.textContent = 'PAUSED';
      return;
    }
    if (!remaining) remaining = duration;
    deadline = Date.now() + remaining * 1000;
    start.textContent = 'PAUSE';
    if (status) status.textContent = 'FOCUS';
    tick();
    interval = window.setInterval(tick, 250);
  });
  reset?.addEventListener('click', () => {
    stop();
    remaining = duration;
    render();
    if (start) start.textContent = 'START';
    if (status) status.textContent = 'READY';
  });
</script>

<style>
  .memento-poster {
    display: grid;
    gap: .75rem;
    width: min(100%, 720px);
    margin-inline: auto;
  }

  .memento-artwork {
    margin: 0;
    min-width: 0;
    background: #100b0b;
  }

  .memento-artwork img {
    display: block;
    width: 100%;
    height: auto;
    filter: none;
    mix-blend-mode: normal;
  }

  .memento-triptych {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .5rem;
  }

  .memento-poster .grunge-strip {
    font-size: clamp(.65rem, 2vw, 1rem);
    padding: .35rem .65rem;
  }

  @media (max-width: 480px) {
    .memento-poster { gap: .5rem; }
    .memento-triptych { gap: .25rem; }
  }
</style>
