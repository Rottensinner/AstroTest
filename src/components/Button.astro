---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'button'> {variant?: 'primary'|'secondary'|'danger'|'ghost'}
const {variant='secondary',type='button',class:cls,...rest}=Astro.props;
---
<button {...rest} type={type} data-variant={variant} class:list={['retro-button',cls]}><slot/></button>
