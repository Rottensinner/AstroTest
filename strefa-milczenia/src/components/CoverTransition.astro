---
const plate = '/zdjecia/wolka-przed-switem.webp';
const duration = 4800;
---
<dialog class="interlude" aria-label="Przejście do prologu" data-duration={duration} style={`--duration: ${duration}ms; --plate: url("${plate}")`}>
  <img class="film-stock" hidden src={plate} alt="" fetchpriority="low" />
  <div class="reel" aria-hidden="true">
    <div class="shot house"><div class="print"></div></div>
    <div class="shot patrol"><div class="print"></div></div>
    <div class="shot window"><div class="print"></div></div>
    <div class="shot infected"><div class="print"></div></div>
  </div>
  <button class="skip-film" type="button" autofocus>Pomiń</button>
</dialog>

<style>
  .interlude {
    position: fixed; inset: 0; width: 100%; height: 100%;
    max-width: none; max-height: none; margin: 0; padding: 0;
    overflow: hidden; border: 0; color: var(--accent); background: #100d0d;
  }
  .interlude::backdrop { background: #100d0d; }
  .reel, .shot {
    position: absolute; inset: 0; overflow: hidden;
  }

  .shot { visibility: hidden; display: grid; grid-template: minmax(0,1fr) / minmax(0,1fr); place-items: center; }
  .print {
    transform-origin: var(--focus);
    width: max(100%, 150dvh);
    aspect-ratio: 3/2;
    background-image: var(--plate);
    background-position: var(--tile);
    background-size: 200% 200%;
    justify-self: center;
  }
  .house {
    --tile: 0% 0%; --at: 0ms; --span: 1450ms;
    --focus: 61% 52%; --from: 1; --to: 1.28;
  }
  .patrol {
    --tile: 100% 0%; --at: 1450ms; --span: 1060ms;
    --focus: 55% 40%; --from: 1.06; --to: 1.18;
  }
  .window {
    --tile: 0% 100%; --at: 2510ms; --span: 1160ms;
    --focus: 60% 56%; --from: 1; --to: 1.45;
  }
  .infected {
    --tile: 100% 100%; --at: 3670ms; --span: calc(var(--duration) - var(--at));
    --focus: 50% 38%; --from: 1.20; --to: 1.23;
  }
  .reel::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: url('/ziarno.png') repeat; opacity: .16; mix-blend-mode: soft-light;
  }
  .interlude[open] .reel { animation: finish-reel var(--duration) linear both; }
  .interlude[open] .shot {
    animation: expose var(--span) linear var(--at);
  }
  .interlude[open] .print { animation: punch var(--span) ease-out var(--at) both; }
  @keyframes expose { from, to { visibility: visible; } }
  @keyframes punch {
    from { transform: scale(var(--from)); }
    to { transform: scale(var(--to)); }
  }
  @keyframes finish-reel {
    0% { opacity: .35; }
    6%, 90% { opacity: 1; }
    100% { opacity: 0; }
  }
  .skip-film {
    position: absolute;
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    right: max(1.25rem, env(safe-area-inset-right));
    min-height: 44px; padding: .5rem 1rem;
    background: #201616; color: var(--paper);
    border: 2px solid var(--line); border-image: var(--ink-frame);
    font: .875rem var(--mono);
  }
  @media (prefers-reduced-motion: reduce) {
    .interlude[open] * { animation: none; }
  }
</style>

<script>
  const start = document.querySelector<HTMLAnchorElement>('#start-reading');
  const dialog = document.querySelector<HTMLDialogElement>('.interlude');
  if (start && dialog && typeof dialog.showModal === 'function') {
    const reelDuration = Number(dialog.dataset.duration);
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const art = dialog.querySelector<HTMLImageElement>('.film-stock')!;
    let timer: number | undefined;
    let leaving = false;
    let preparing = false;

    function finish() {
      if (!dialog?.open || leaving) return;
      leaving = true;
      clearTimeout(timer);
      location.assign(start!.href);
    }

    start.addEventListener('click', async (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey ||
          event.shiftKey || event.altKey || motion.matches) return;
      event.preventDefault();
      if (preparing || dialog.open) return;
      preparing = true;
      if (!art.complete || !art.naturalWidth) {
        // On slow connections keep the cover visible, then go straight to the story.
        await Promise.race([
          art.decode().catch(() => {}),
          new Promise<void>((resolve) => window.setTimeout(resolve, 550)),
        ]);
      }
      if (!preparing) return;
      if (!art.naturalWidth || motion.matches) {
        location.assign(start.href);
        return;
      }
      dialog.showModal();
      // Keep navigation available if the animation is interrupted.
      timer = window.setTimeout(finish, reelDuration + 450);
    });
    dialog.addEventListener('animationend', (event) => {
      if (event.target === dialog.querySelector('.reel')) finish();
    });
    dialog.querySelector('button')!.addEventListener('click', finish);
    dialog.addEventListener('cancel', (event) => { event.preventDefault(); finish(); });
    motion.addEventListener('change', (event) => { if (event.matches) finish(); });
    window.addEventListener('pageshow', () => {
      clearTimeout(timer);
      leaving = false;
      preparing = false;
      if (dialog.open) dialog.close();
    });
  }
</script>
